# Target backend untuk Next.js rewrites (server-side). Wajib di production jika tidak pakai NEXT_PUBLIC_* di atas.
# Contoh lokal / Tailscale:
JOBS_API_BASE_URL=http://100.123.25.78:8088
MANA_UANG_API_BASE_URL=http://100.123.25.78:8089

# Login dashboard (wajib). Bandingkan di server; jangan commit nilai asli ke repo publik.
APP_LOGIN_PIN=ubah-ini
# Tanda tangan cookie sesi (wajib di production). Minimal panjang acak, mis. openssl rand -hex 32
APP_SESSION_SECRET=ubah-ini-min-32-karakter-acak
