# URL backend (browser): tidak dipakai lagi oleh app; proxy lewat Next rewrites.
# Opsional jika kamu ingin satu sumber kebenaran; rewrites juga bisa baca ini sebagai fallback.
NEXT_PUBLIC_API_BASE_URL=http://100.123.25.78:8088
NEXT_PUBLIC_MANA_UANG_API_BASE_URL=http://100.123.25.78:8089

# Target backend untuk Next.js rewrites (server-side). Wajib di production jika tidak pakai NEXT_PUBLIC_* di atas.
# Contoh lokal / Tailscale:
JOBS_API_BASE_URL=http://100.123.25.78:8088
MANA_UANG_API_BASE_URL=http://100.123.25.78:8089
